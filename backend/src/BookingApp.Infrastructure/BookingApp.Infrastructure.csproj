<Project Sdk="Microsoft.NET.Sdk">
  <!-- Adapters for the ports in BookingApp.Core: repositories (in-memory, EF Core), seeding. -->
  <PropertyGroup>
    <RootNamespace>BookingApp.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <!-- Design-time only: lets dotnet-ef create migrations from this project. Not shipped. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BookingApp.Core\BookingApp.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BookingApp.Infrastructure.Tests" />
    <InternalsVisibleTo Include="BookingApp.Core.Tests" />
    <InternalsVisibleTo Include="BookingApp.Api.Tests" />
  </ItemGroup>
</Project>
