{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=.data/bookings.db"
  },
  "Venue": {
    "Name": "Riverside Sports Club",
    "TimeZoneId": "Asia/Ho_Chi_Minh",
    "Resources": [
      {
        "Id": "court-1",
        "Name": "Tennis court 1",
        "Kind": "Court",
        "Capacity": 4,
        "SlotMinutes": 60,
        "MaxSlotsPerBooking": 2,
        "Hours": { "Monday-Friday": "06:00-22:00", "Saturday-Sunday": "07:00-21:00" }
      },
      {
        "Id": "court-2",
        "Name": "Tennis court 2",
        "Kind": "Court",
        "Capacity": 4,
        "SlotMinutes": 60,
        "MaxSlotsPerBooking": 2,
        "Hours": { "Monday-Friday": "06:00-22:00", "Saturday-Sunday": "07:00-21:00" }
      },
      {
        "Id": "room-a",
        "Name": "Meeting room A",
        "Kind": "Room",
        "Capacity": 8,
        "SlotMinutes": 30,
        "MaxSlotsPerBooking": 6,
        "Hours": { "Monday-Saturday": "08:00-20:00" }
      }
    ]
  },
  "Booking": {
    "MaxDaysAhead": 30,
    "MinLeadMinutes": 15,
    "CancellationCutoffHours": 2,
    "MaxActiveBookingsPerCustomer": 5
  },
  "Holds": {
    "Minutes": 10,
    "SweepSeconds": 15
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
