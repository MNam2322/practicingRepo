    Not part of the app; see docs/performance.md for how to run it (from backend/, in Release).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>BookingApp.Perf</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BookingApp.Infrastructure\BookingApp.Infrastructure.csproj" />
  </ItemGroup>
</Project>
