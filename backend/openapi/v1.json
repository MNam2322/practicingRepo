{
  "openapi": "3.1.1",
  "info": {
    "title": "Booking API",
    "description": "Courts and rooms at the club: availability, booking and cancelling. Times named start/end are UTC instants; localStart/localEnd are venue wall-clock times for display. Errors are RFC 9457 problem details with a stable `code`.",
    "version": "v1"
  },
  "paths": {
    "/api/bookings": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Books one or more consecutive slots.",
        "description": "Send a slot's start exactly as the availability response gave it. Someone may book the same slot first: then the answer is 409 slot_taken.",
        "operationId": "CreateBooking",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request body could not be read.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "resource_not_found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "slot_taken",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "too_soon, too_far_ahead, not_whole_slots, too_long, outside_opening_hours, not_on_slot_grid, name_required, too_many_bookings",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/mine": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "The current customer's bookings, oldest first.",
        "operationId": "GetMyBookings",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookingResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{id}": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "One of the current customer's bookings.",
        "operationId": "GetBooking",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The booking id.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "404": {
            "description": "booking_not_found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{id}/cancel": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Cancels a booking while the cancellation rules allow it.",
        "operationId": "CancelBooking",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The booking id.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                }
              }
            }
          },
          "403": {
            "description": "not_your_booking",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "booking_not_found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "not_cancellable, changed_meanwhile",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "too_late_to_cancel",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/resources": {
      "get": {
        "tags": [
          "Resources"
        ],
        "summary": "Courts and rooms, with opening hours.",
        "operationId": "GetResources",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResourceResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/resources/{id}/availability": {
      "get": {
        "tags": [
          "Resources"
        ],
        "summary": "A resource's slots for one venue-local day.",
        "operationId": "GetAvailability",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The resource id, such as court-1.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "description": "A venue-local day (yyyy-MM-dd). Leave it out for today at the venue.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            }
          },
          "400": {
            "description": "The date could not be read.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "resource_not_found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/venue": {
      "get": {
        "tags": [
          "Venue"
        ],
        "summary": "The venue, its time zone and the booking rules.",
        "operationId": "GetVenue",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenueResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AvailabilityResponse": {
        "required": [
          "resourceId",
          "date",
          "timeZone",
          "slots"
        ],
        "type": "object",
        "properties": {
          "resourceId": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "timeZone": {
            "type": "string"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlotResponse"
            }
          }
        }
      },
      "BookingResponse": {
        "required": [
          "id",
          "resourceId",
          "resourceName",
          "start",
          "end",
          "localStart",
          "localEnd",
          "status",
          "customerName",
          "createdAt",
          "cancelledAt",
          "canCancel"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "resourceId": {
            "type": "string"
          },
          "resourceName": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "localStart": {
            "type": "string"
          },
          "localEnd": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "customerName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "canCancel": {
            "type": "boolean"
          }
        }
      },
      "BookingStatus": {
        "enum": [
          "confirmed",
          "cancelled",
          "completed",
          "noShow"
        ],
        "description": "Confirmed → Cancelled, or Confirmed → Completed / NoShow after it ends (staff actions, TASKS.md).\nLibrary: 4.7 \"Example 2: A booking lifecycle as a state machine\", 12.6 \"State machines for aggregate lifecycles\"."
      },
      "CreateBookingRequest": {
        "required": [
          "resourceId",
          "start",
          "slots",
          "name"
        ],
        "type": "object",
        "properties": {
          "resourceId": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "description": "The UTC start of the first slot, exactly as returned by the availability endpoint.",
            "format": "date-time"
          },
          "slots": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "How many consecutive slots, default 1.",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "description": "The name the booking is under."
          }
        }
      },
      "DayOfWeek": {
        "enum": [
          "sunday",
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday"
        ]
      },
      "OpeningHoursResponse": {
        "required": [
          "day",
          "open",
          "close"
        ],
        "type": "object",
        "properties": {
          "day": {
            "$ref": "#/components/schemas/DayOfWeek"
          },
          "open": {
            "type": "string"
          },
          "close": {
            "type": "string"
          }
        }
      },
      "PolicyResponse": {
        "required": [
          "maxDaysAhead",
          "minLeadMinutes",
          "cancellationCutoffHours",
          "maxActiveBookingsPerCustomer"
        ],
        "type": "object",
        "properties": {
          "maxDaysAhead": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "minLeadMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "cancellationCutoffHours": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "maxActiveBookingsPerCustomer": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "code": {
            "type": "string",
            "description": "Stable error code such as slot_taken or too_late_to_cancel. Clients switch on this, not on title."
          }
        }
      },
      "ResourceKind": {
        "enum": [
          "court",
          "room",
          "table",
          "other"
        ]
      },
      "ResourceResponse": {
        "required": [
          "id",
          "name",
          "kind",
          "capacity",
          "slotMinutes",
          "maxSlotsPerBooking",
          "hours"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ResourceKind"
          },
          "capacity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "slotMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "maxSlotsPerBooking": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "hours": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpeningHoursResponse"
            }
          }
        }
      },
      "SlotResponse": {
        "required": [
          "start",
          "end",
          "localStart",
          "localEnd",
          "state"
        ],
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "localStart": {
            "type": "string"
          },
          "localEnd": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/SlotState"
          }
        }
      },
      "SlotState": {
        "enum": [
          "free",
          "booked",
          "past"
        ]
      },
      "VenueResponse": {
        "required": [
          "name",
          "timeZone",
          "policy"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "policy": {
            "$ref": "#/components/schemas/PolicyResponse"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Bookings"
    },
    {
      "name": "Resources"
    },
    {
      "name": "Venue"
    }
  ]
}
