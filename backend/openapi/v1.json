              }
            }
          },
          "404": {
            "description": "resource_not_found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "bookings_in_the_way",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "end_before_start, reason_required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/venue": {
      "get": {
        "tags": [
          "Venue"
        ],
        "summary": "The venue, its time zone and the booking rules.",
        "operationId": "GetVenue",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenueResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountResponse": {
        "required": [
          "id",
          "email",
          "name",
          "roles"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Customer, and Staff or Admin where granted."
          }
        },
        "description": "The signed-in account."
      },
      "AvailabilityResponse": {
        "required": [
          "resourceId",
          "date",
          "timeZone",
          "slots",
          "closures"
        ],
        "type": "object",
        "properties": {
          "resourceId": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "timeZone": {
